NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails
# Optional when Elasticsearch security is enabled
ELASTICSEARCH_API_KEY=
# Generate each independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
ETHEREAL_USER=
ETHEREAL_PASSWORD=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
WORKER_CONCURRENCY=10
INDEX_WORKER_CONCURRENCY=5
SLACK_WORKER_CONCURRENCY=1
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_RECIPIENTS=10000
MAX_UPLOAD_BYTES=2097152
REQUEST_LIMIT_BYTES=5242880
SESSION_TTL_SECONDS=604800
SENDER_LEASE_MS=120000
SMTP_TIMEOUT_MS=30000
# Comma-separated Google account emails allowed to view Bull Board (read-only).
ADMIN_EMAILS=
LOG_LEVEL=info
# Tests require dedicated infrastructure, never point these at production.
TEST_DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox_test
TEST_REDIS_URL=redis://localhost:6379/15
TEST_ELASTICSEARCH_URL=http://localhost:9200
