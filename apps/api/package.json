{
  "name": "@reachinbox/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/main.ts",
    "build": "tsc -p tsconfig.json",
