    "worker": "node dist/apps/api/src/workers/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.0",
    "@bull-board/express": "^6.14.0",
    "@elastic/elasticsearch": "^8.19.0",
